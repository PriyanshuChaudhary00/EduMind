# EduMind Backend Environment Variables
PROJECT_NAME="EduMind API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection:
# For local SQLite development (zero setup required):
DATABASE_URL="sqlite:///./edumind.db"
# For PostgreSQL / pgvector (Neon, Supabase, or Docker):
# DATABASE_URL="postgresql://username:password@localhost:5432/edumind"

# JWT Auth Secret (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY="edumind-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API (Required for later phases: RAG, Quizzes, Flashcards)
# OPENAI_API_KEY="your-api-key-here"
# HUGGINGFACE_API_KEY="your-hf-token-here"
